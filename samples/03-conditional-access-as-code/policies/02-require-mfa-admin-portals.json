{
  "displayName": "CAC002 Require MFA for admin portals",
  "state": "enabledForReportingButNotEnforced",
  "conditions": {
    "users": {
      "includeUsers": ["All"],
      "excludeGroups": ["${BREAK_GLASS_GROUP_ID}"]
    },
    "applications": {
      "includeApplications": ["MicrosoftAdminPortals"]
    },
    "clientAppTypes": ["all"],
    "signInRiskLevels": [],
    "userRiskLevels": []
  },
  "grantControls": {
    "operator": "OR",
    "builtInControls": ["mfa"]
  },
  "sessionControls": {
    "signInFrequency": {
      "isEnabled": true,
      "type": "hours",
      "value": 4,
      "authenticationType": "primaryAndSecondaryAuthentication",
      "frequencyInterval": "timeBased"
    }
  }
}
